#!/usr/bin/env python3
"""Fail if .swiftlint-baseline.json lets in more than main's copy does.

The baseline hides recorded violations from SwiftLint, so regenerating it would hide new ones too.
An entry may be removed or shrink. It may not be added, and its size may grow only when the same
change removes another entry for that file.
"""

import json
import re
import subprocess
import sys
from collections import defaultdict

BASELINE = ".swiftlint-baseline.json"


def git(*args):
    return subprocess.run(["git", *args], capture_output=True, text=True)


def base_commit():
    for ref in ("origin/main", "main"):
        found = git("merge-base", "HEAD", ref)
        if found.returncode == 0:
            return found.stdout.strip()
    sys.exit("baseline-ratchet: no main branch to compare with; fetch it first")


def entries(text):
    sized = {}
    for entry in json.loads(text):
        violation = entry["violation"]
        key = (violation["location"]["file"], violation["ruleIdentifier"], entry["text"].strip())
        numbers = re.findall(r"\d+", violation["reason"])
        sized[key] = int(numbers[-1]) if numbers else 0
    return sized


def main():
    base = base_commit()
    before_text = git("show", f"{base}:{BASELINE}")
    before = entries(before_text.stdout) if before_text.returncode == 0 else {}
    with open(BASELINE, encoding="utf-8") as file:
        after = entries(file.read())

    removed_files = {key[0] for key in before if key not in after}
    problems = []
    for key, size in sorted(after.items()):
        path, rule, text = key
        if key not in before:
            problems.append(f"{path}: new {rule} entry ({text!r}, {size})")
        elif size > before[key] and path not in removed_files:
            problems.append(f"{path}: {rule} grew from {before[key]} to {size} ({text!r})")

    if problems:
        print(f"{BASELINE} lets in more than {base[:7]} does:", file=sys.stderr)
        for problem in problems:
            print(f"  {problem}", file=sys.stderr)
        print("Shrink the code instead; see CLAUDE.md, Checks.", file=sys.stderr)
        sys.exit(1)


main()
